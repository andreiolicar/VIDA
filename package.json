{
  "name": "vida",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sequelize-cli": "^6.6.3"
  },
  "scripts": {
    "install-all": "npm install && npm run install-backend && npm run install-frontend",
    "install-backend": "cd backend && npm install",
    "install-frontend": "cd frontend && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && nodemon src/server.js",
    "client": "cd frontend && npm run dev",
    "setup": "cd backend && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "drop-db": "cd backend && npx sequelize-cli db:drop"

  },
  "dependencies": {
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "p-limit": "^6.2.0",
    "recharts": "^2.15.3",
    "sequelize": "^6.37.7"
  }
}
